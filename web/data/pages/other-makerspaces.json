    "id": "HtmlSection-171",
    "html": "<section class=\"about-2 section\" id=\"other-makerspaces\">\n  <div class=\"container\">\n    <div class=\"row justify-content-center\">\n      <div class=\"col-lg-10\">\n        <div class=\"title text-center\">\n          <h2>Connect with Other Michigan Makerspaces</h2>\n          <p>Michigan has a growing ecosystem of makerspaces, hackerspaces, and community workshops. If you travel, move, or want to collaborate with other groups, this list is a good place to start.</p>\n          <div class=\"border\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Community & Independent Makerspaces -->\n    <div class=\"row justify-content-center mt-5\">\n      <div class=\"col-lg-10\">\n        <h3 class=\"mb-3\">Community &amp; Independent Makerspaces</h3>\n        <div class=\"table-responsive\">\n          <table class=\"table table-striped table-bordered\">\n            <thead class=\"thead-dark\">\n              <tr>\n                <th scope=\"col\">City</th>\n                <th scope=\"col\">Makerspace</th>\n                <th scope=\"col\">Web Address</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td>Ann Arbor</td>\n                <td>All Hands Active</td>\n                <td><a href=\"https://allhandsactive.org/\" target=\"_blank\" rel=\"noopener\">https://allhandsactive.org/</a></td>\n              </tr>\n              <tr>\n                <td>Ann Arbor</td>\n                <td>Maker Works</td>\n                <td><a href=\"https://www.maker-works.com/\" target=\"_blank\" rel=\"noopener\">https://www.maker-works.com/</a></td>\n              </tr>\n              <tr>\n                <td>Detroit</td>\n                <td>Brightmoor Makerspace</td>\n                <td><a href=\"https://brightmoormakerspace.org/\" target=\"_blank\" rel=\"noopener\">https://brightmoormakerspace.org/</a></td>\n              </tr>\n              <tr>\n                <td>Ferndale</td>\n                <td>i3Detroit</td>\n                <td><a href=\"http://www.i3detroit.org/\" target=\"_blank\" rel=\"noopener\">http://www.i3detroit.org/</a></td>\n              </tr>\n              <tr>\n                <td>Flint</td>\n                <td>Factory Two</td>\n                <td><a href=\"http://factorytwo.org/\" target=\"_blank\" rel=\"noopener\">http://factorytwo.org/</a></td>\n              </tr>\n              <tr>\n                <td>Grand Rapids</td>\n                <td>Grand River Makerspace</td>\n                <td><a href=\"https://www.grandrivermakerspace.org/\" target=\"_blank\" rel=\"noopener\">https://www.grandrivermakerspace.org/</a></td>\n              </tr>\n              <tr>\n                <td>Houghton</td>\n                <td>MTU Makerspace</td>\n                <td><a href=\"https://www.makerspace.mtu.edu/\" target=\"_blank\" rel=\"noopener\">https://www.makerspace.mtu.edu/</a></td>\n              </tr>\n              <tr>\n                <td>Houghton</td>\n                <td>MTU ECE Makerspace</td>\n                <td><a href=\"https://www.makerspace.ece.mtu.edu/\" target=\"_blank\" rel=\"noopener\">https://www.makerspace.ece.mtu.edu/</a></td>\n              </tr>\n              <tr>\n                <td>Jackson</td>\n                <td>Jackson Makerspace</td>\n                <td><a href=\"https://www.jacksonmakerspace.net/\" target=\"_blank\" rel=\"noopener\">http://tomlinsontalent.org/</a></td>\n              </tr>\n              <tr>\n                <td>Lansing</td>\n                <td>Lansing Makers Network</td>\n                <td><a href=\"https://www.lansingmakersnetwork.org/\" target=\"_blank\" rel=\"noopener\">https://www.lansingmakersnetwork.org/</a></td>\n              </tr>\n              <tr>\n                <td>Marquette</td>\n                <td>MAPS Makerspace</td>\n                <td><a href=\"https://united.mapsmakerspace.org/\" target=\"_blank\" rel=\"noopener\">https://mshs.mapsnet.org/facilities</a></td>\n              </tr>\n              <tr>\n                <td>Muskegon</td>\n                <td>Lakeshore Fab Lab</td>\n                <td><a href=\"http://www.lakeshorefablab.com/\" target=\"_blank\" rel=\"noopener\">http://www.lakeshorefablab.com/</a></td>\n              </tr>\n              <tr>\n                <td>Port Huron</td>\n                <td>FORGE Makerspace</td>\n                <td><a href=\"https://www.theforgeph.com/\" target=\"_blank\" rel=\"noopener\">https://www.theforgeph.com/</a></td>\n              </tr>\n              <tr>\n                <td>Troy</td>\n                <td>Open Workshops</td>\n                <td><a href=\"https://www.open-workshops.com/\" target=\"_blank\" rel=\"noopener\">https://www.open-workshops.com/</a></td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <!-- City-Affiliated & Library Makerspaces -->\n    <div class=\"row justify-content-center mt-5\">\n      <div class=\"col-lg-10\">\n        <h3 class=\"mb-3\">City-Affiliated &amp; Library Makerspaces</h3>\n        <div class=\"table-responsive\">\n          <table class=\"table table-striped table-bordered\">\n            <thead class=\"thead-dark\">\n              <tr>\n                <th scope=\"col\">City</th>\n                <th scope=\"col\">Makerspace</th>\n                <th scope=\"col\">Web Address</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td>Farmington Hills</td>\n                <td>The Hawk Makerspace</td>\n                <td><a href=\"https://www.fhgov.com/makerspace\" target=\"_blank\" rel=\"noopener\">https://www.fhgov.com/makerspace</a></td>\n              </tr>\n              <tr>\n                <td>Kalamazoo</td>\n                <td>Idea Lab (Kalamazoo Public Library)</td>\n                <td><a href=\"https://www.kpl.gov/idea-lab\" target=\"_blank\" rel=\"noopener\">https://www.kpl.gov/idea-lab/3d-printing/</a></td>\n              </tr>\n              <tr>\n                <td>Novi</td>\n                <td>iCube Makerspace (Novi Public Library)</td>\n                <td><a href=\"https://www.novilibrary.org/icube/\" target=\"_blank\" rel=\"noopener\">https://www.novilibrary.org/icube/</a></td>\n              </tr>\n              <tr>\n                <td>Portage</td>\n                <td>Creation Station (Portage District Library)</td>\n                <td><a href=\"https://www.portagelibrary.info/creation-station/\" target=\"_blank\" rel=\"noopener\">https://www.portagelibrary.info/creation-station/</a></td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"mt-4\"><small>Kzoo Makers has no affiliation to these organizations. This list is provided as a community resource. Links may change over time; please check each makerspace’s website for the most current information.</small></p>\n      </div>\n    </div>\n  </div>\n</section>"
   }
