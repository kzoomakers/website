    "id": "HtmlSection-175",
    "html": "<section class=\"portfolio section-sm\" id=\"fiber-arts-gallery\">\n                <div class=\"row\">\n                    <div class=\"col-lg-12\">\n                        <div class=\"row\">\n                            <div class=\"col-12\">\n                                <div class=\"filtr-container\">\n\n                                        <div class=\"col-md-3 col-sm-6 col-xs-6 filtr-item\" data-category=\"all\">\n                                            <div class=\"portfolio-block\">\n                                                <img class=\"img-fluid\" src=\"/images/fiberart/Kzoo Fiber Arts Meetup_1.webp\" alt=\"Fiber arts meetup members working together at large tables\">\n                                                <div class=\"caption\">\n                                                    <a class=\"search-icon\" href=\"images/fiberart/Kzoo Fiber Arts Meetup_1.webp\" data-lightbox=\"fiberarts\">\n                                                        <i class=\"tf-ion-ios-search-strong\"></i>\n                                                    </a>\n                                                    <h4><a href=\"#\">Fiber Arts Meetup at Kzoo Makers</a></h4>\n                                                </div>\n                                            </div>\n                                        </div>\n\n                                        <div class=\"col-md-3 col-sm-6 col-xs-6 filtr-item\" data-category=\"all\">\n                                            <div class=\"portfolio-block\">\n                                                <img class=\"img-fluid\" src=\"/images/fiberart/crochet-art.webp\" alt=\"Close-up of colorful crochet artwork and amigurumi pieces\">\n                                                <div class=\"caption\">\n                                                    <a class=\"search-icon\" href=\"images/fiberart/crochet-art.webp\" data-lightbox=\"fiberarts\">\n                                                        <i class=\"tf-ion-ios-search-strong\"></i>\n                                                    </a>\n                                                    <h4><a href=\"#\">Crochet Art &amp; Amigurumi</a></h4>\n                                                </div>\n                                            </div>\n                                        </div>\n\n                                        <div class=\"col-md-3 col-sm-6 col-xs-6 filtr-item\" data-category=\"all\">\n                                            <div class=\"portfolio-block\">\n                                                <img class=\"img-fluid\" src=\"/images/fiberart/knit_slipper_socks.webp\" alt=\"Hand-knit slipper socks with a cozy textured pattern\">\n                                                <div class=\"caption\">\n                                                    <a class=\"search-icon\" href=\"images/fiberart/knit_slipper_socks.webp\" data-lightbox=\"fiberarts\">\n                                                        <i class=\"tf-ion-ios-search-strong\"></i>\n                                                    </a>\n                                                    <h4><a href=\"#\">Hand-Knit Slipper Socks</a></h4>\n                                                </div>\n                                            </div>\n                                        </div>\n\n                                        <div class=\"col-md-3 col-sm-6 col-xs-6 filtr-item\" data-category=\"all\">\n                                            <div class=\"portfolio-block\">\n                                                <img class=\"img-fluid\" src=\"/images/fiberart/dyed_yarn.webp\" alt=\"Skeins of hand-dyed yarn in bright, saturated colors\">\n                                                <div class=\"caption\">\n                                                    <a class=\"search-icon\" href=\"images/fiberart/dyed_yarn.webp\" data-lightbox=\"fiberarts\">\n                                                        <i class=\"tf-ion-ios-search-strong\"></i>\n                                                    </a>\n                                                    <h4><a href=\"#\">Hand-Dyed Yarn Experiments</a></h4>\n                                                </div>\n                                            </div>\n                                        </div>\n\n                                        <div class=\"col-md-3 col-sm-6 col-xs-6 filtr-item\" data-category=\"all\">\n                                            <div class=\"portfolio-block\">\n                                                <img class=\"img-fluid\" src=\"/images/fiberart/Yarn_Dyeing_Workshop_1.webp\" alt=\"Instructor demonstrating yarn dyeing techniques at a workshop\">\n                                                <div class=\"caption\">\n                                                    <a class=\"search-icon\" href=\"images/fiberart/Yarn_Dyeing_Workshop_1.webp\" data-lightbox=\"fiberarts\">\n                                                        <i class=\"tf-ion-ios-search-strong\"></i>\n                                                    </a>\n                                                    <h4><a href=\"#\">Yarn Dyeing Workshop Demo</a></h4>\n                                                </div>\n                                            </div>\n                                        </div>\n\n                                        <div class=\"col-md-3 col-sm-6 col-xs-6 filtr-item\" data-category=\"all\">\n                                            <div class=\"portfolio-block\">\n                                                <img class=\"img-fluid\" src=\"/images/fiberart/Yarn Dyeing Workshop_2.webp\" alt=\"Participants preparing yarn and color for a dyeing workshop\">\n                                                <div class=\"caption\">\n                                                    <a class=\"search-icon\" href=\"images/fiberart/Yarn Dyeing Workshop_2.webp\" data-lightbox=\"fiberarts\">\n                                                        <i class=\"tf-ion-ios-search-strong\"></i>\n                                                    </a>\n                                                    <h4><a href=\"#\">Hands-On Yarn Dyeing</a></h4>\n                                                </div>\n                                            </div>\n                                        </div>\n\n                                        <div class=\"col-md-3 col-sm-6 col-xs-6 filtr-item\" data-category=\"all\">\n                                            <div class=\"portfolio-block\">\n                                                <img class=\"img-fluid\" src=\"/images/fiberart/dan_campbell_mascot_head_cosplay.webp\" alt=\"Foam mascot head cosplay project built with fiber and foam details\">\n                                                <div class=\"caption\">\n                                                    <a class=\"search-icon\" href=\"images/fiberart/dan_campbell_mascot_head_cosplay.webp\" data-lightbox=\"fiberarts\">\n                                                        <i class=\"tf-ion-ios-search-strong\"></i>\n                                                    </a>\n                                                    <h4><a href=\"#\">Cosplay Mascot Head Build</a></h4>\n                                                </div>\n                                            </div>\n                                        </div>\n\n                                        <div class=\"col-md-3 col-sm-6 col-xs-6 filtr-item\" data-category=\"all\">\n                                            <div class=\"portfolio-block\">\n                                                <img class=\"img-fluid\" src=\"/images/fiberart/turfting.jpeg\" alt=\"Tufting at Kalamazoo Makers\">\n                                                <div class=\"caption\">\n                                                    <a class=\"search-icon\" href=\"images/fiberart/turfting.jpeg\" data-lightbox=\"fiberarts\">\n                                                        <i class=\"tf-ion-ios-search-strong\"></i>\n                                                    </a>\n                                                    <h4><a href=\"#\">Tufting at Kalamazoo Makers</a></h4>\n                                                </div>\n                                            </div>\n                                        </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div> <!-- /end col-lg-12 -->\n                </div> <!-- end row -->\n             <!-- end container -->\n        </section>"
