   "type": "HtmlSection",
   "props": {
    "id": "HtmlSection-205",
    "html": "<section class=\"about-shot-info section-sm\">\n\t<div class=\"container\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-lg-6 mt-20\">\n\t\t\t\t<h2 class=\"mb-3\">Help Spread the Word</h2>\n\t\t\t\t<p>Want to help grow our maker community? Download and print our promotional flyers to post around Kalamazoo!</p>\n\t\t\t\t<p>These flyers are designed to introduce people to Kzoo Makers and invite them to explore what our community makerspace has to offer. Whether you're posting at coffee shops, community boards, local businesses, or campus bulletin boards, every flyer helps us reach potential new makers.</p>\n\t\t\t\t<p>Each design is available in two formats:</p>\n\t\t\t\t<ul>\n\t\t\t\t\t<li><strong>PDF</strong> - Ready to print, perfect for quick distribution</li>\n\t\t\t\t\t<li><strong>SVG</strong> - Editable vector format for customization</li>\n\t\t\t\t</ul>\n\t\t\t\t<p>Thank you for helping us build a stronger maker community in Kalamazoo!</p>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-6 mt-4 mt-lg-0\">\n\t\t\t\t<img loading=\"lazy\" class=\"img-fluid\" src=\"/images/clipart/bulb.webp\" alt=\"Spread the word about Kzoo Makers\">\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>"
   }
  },
