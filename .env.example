# Copy to .env for local dev. NEVER commit real values; this repo is PUBLIC.
# Prod values live in Fly secrets: `fly secrets set KEY=value`
# CI values live in GitHub Actions secrets.

# Aiven MySQL/Postgres service URI (include sslmode / ssl-mode=REQUIRED)
DATABASE_URL=
# Aiven CA cert contents (or mount path); download from Aiven console
DATABASE_CA_CERT=

# Auth for the /edit route (Puck editor)
AUTH_SECRET=
ADMIN_EMAILS=

# Contact form (replaces the OpenResty/Lua token flow in docs/contact)
SMTP2GO_API_KEY=
CONTACT_HMAC_SECRET=
CONTACT_TO_EMAIL=

# Uploaded images (Fly volume path or S3-compatible bucket)
UPLOAD_DIR=/data/uploads
